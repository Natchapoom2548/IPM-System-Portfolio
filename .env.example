# Optional locally; required in production. Use a pooled connection for serverless deployments.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true

# Generate unique high-entropy values for every deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
DEFAULT_USER_PASSWORD=replace-with-a-strong-temporary-user-password

# Enables the non-persistent sample store in a portfolio deployment.
# Set to false when DATABASE_URL is configured.
DEMO_MODE=true

# Optional: comma-separated origins allowed to call the API cross-origin.
# Same-origin browser requests work without this setting.
CORS_ORIGIN=http://localhost:3000

# Firebase Web configuration for the optional Google Sheets integration.
# These values identify a Firebase Web app and are embedded in the browser bundle.
# Restrict the Firebase API key and authorized domains in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
